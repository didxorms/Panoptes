# Load explicitly with: node --env-file=.env src/server.mjs
PANOPTES_PORT=3100
PANOPTES_HOST=127.0.0.1
PANOPTES_DATA_DIR=.panoptes
# Optional: otherwise a random local token is saved in .panoptes/admin.token.
# PANOPTES_ADMIN_TOKEN=replace-with-at-least-32-random-characters
# Base64 encoding of exactly 32 random bytes; otherwise persisted locally.
# PANOPTES_MASTER_KEY=
# Actual Lean verification requires a locally built image. No automatic pulls.
PANOPTES_LEAN_IMAGE=panoptes-lean:4.28.0
