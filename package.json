{
  "name": "panoptes",
  "version": "0.0.0",
  "private": true,
  "description": "A shared, verifiable workspace for AI-led mathematical research.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "demo": "node src/cli.mjs demo",
    "test": "node --test test/*.test.mjs",
    "test:lean": "node --test test/lean.integration.mjs",
    "check": "node scripts/check.mjs",
    "version:next": "node scripts/version.mjs",
    "release:push": "node scripts/push.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
